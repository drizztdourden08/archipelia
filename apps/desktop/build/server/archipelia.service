# @layer tooling-scripts @kind build
# Managed by brock sync: the systemd unit the .deb installs.
[Unit]
Description=Archipelia server (ports 38290, 38281)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=archipelia
Group=archipelia
StateDirectory=archipelia
StateDirectoryMode=0750
UMask=0027
ExecStart=/opt/archipelia/bin/archipelia-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
