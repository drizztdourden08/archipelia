{
  "name": "@drizztdourden08/archipelia-lobby-protocol",
  "version": "1.2.0",
  "description": "The Archipelia lobby protocol: message types, JSON Schemas, codec, version rules, fixtures, a fake client and a fake server.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizztdourden08/archipelia.git",
    "directory": "packages/lobby-protocol"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/types/node/index.d.ts",
        "default": "./dist/node.js"
      },
      "./testing": {
        "types": "./dist/types/testing/index.d.ts",
        "default": "./dist/testing.js"
      },
      "./fixtures/*": "./fixtures/*",
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./testing": "./src/testing/index.ts",
    "./fixtures/*": "./fixtures/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json && eslint ."
  },
  "devDependencies": {
    "@archipelia/package-build": "workspace:*",
    "@drizztdourden08/brock-lint-config": "^0.113.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
