{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        ".markdownlint-cli2.mjs",
        "brock.workspace.mjs",
        "eslint.config.mjs",
        "stylelint.config.mjs"
      ],
      "project": [
        "*.{mjs,ts}"
      ]
    },
    "apps/desktop": {
      "entry": [
        "electron/main.ts",
        "electron/preload.ts",
        "electron/services/app-services.type.ts",
        "src/main.tsx",
        "src/screens/**/*.custom.tsx",
        "src/views/*/*.usage.ts",
        "src/view-parts.type.ts",
        ".brock/*.ts",
        "brock.config.ts",
        "*.config.{cjs,ts,mjs}",
        "tests/**/*.keep.test.ts",
        "tests/e2e/**/*.e2e.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        ".brock/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/model": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "tests/**/*.keep.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "tooling/engine-bundle": {
      "entry": [
        "bin/*.mjs",
        "tests/**/*.keep.test.mjs"
      ],
      "project": [
        "src/**/*.mjs",
        "bin/*.mjs",
        "tests/**/*.mjs"
      ]
    },
    "packages/design": {
      "entry": [
        "tests/**/*.keep.test.ts",
        "src/compounds/*/*.usage.ts",
        "src/guide/app-tree.*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": [
        "vite"
      ]
    }
  }
}
