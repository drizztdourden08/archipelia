{
  "name": "archipelia",
  "version": "0.1.0",
  "private": true,
  "description": "Archipelia: the Archipelago multiworld workflow in one app. Games store, presets, sessions, an invisible generator and embedded servers.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizztdourden08/archipelia.git"
  },
  "author": {
    "name": "drizztdourden_",
    "email": "drizztdourden08@users.noreply.github.com"
  },
  "type": "module",
  "exports": {
    "./registry/registry.json": "./registry/registry.json",
    "./registry/registry.schema.json": "./registry/registry.schema.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "standards lint",
    "lint:all": "standards lint --all",
    "lint:md": "markdownlint-cli2",
    "structure": "brock structure --check",
    "test": "standards test",
    "test:pr": "standards test pr",
    "build": "pnpm --filter ./apps/desktop build",
    "test:e2e": "standards test e2e",
    "prose": "brock prose",
    "deadcode": "brock knip",
    "duplicates": "jscpd .",
    "postinstall": "node bin/archipelia.mjs --link"
  },
  "devDependencies": {
    "@archipelia/engine-bundle": "workspace:*",
    "@drizztdourden08/brock-build": "^0.116.0",
    "@drizztdourden08/brock-lint-config": "^0.116.0",
    "@drizztdourden08/brock-thread": "^0.116.0",
    "@drizztdourden08/standards": "^0.14.2",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "archipelia": "./bin/archipelia.mjs"
  },
  "brock": {
    "version": "0.116.0"
  },
  "packageManager": "pnpm@10.17.0"
}
