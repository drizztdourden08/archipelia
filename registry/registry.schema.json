{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/drizztdourden08/archipelia/main/registry/registry.schema.json",
  "title": "Archipelia registry",
  "type": "object",
  "required": ["format", "clients", "games"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "clients": { "type": "array", "items": { "$ref": "#/$defs/client" } },
    "games": { "type": "array", "items": { "$ref": "#/$defs/game" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "textList": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "client": {
      "type": "object",
      "required": ["id", "name", "homepage", "games", "status", "trust"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "$ref": "#/$defs/text" },
        "homepage": { "type": "string", "format": "uri" },
        "games": { "$ref": "#/$defs/textList" },
        "status": { "enum": ["active", "revoked"] },
        "trust": { "$ref": "#/$defs/githubAttestation" }
      }
    },
    "githubAttestation": {
      "type": "object",
      "required": ["method", "repo", "workflow", "refs", "issuer"],
      "additionalProperties": false,
      "properties": {
        "method": { "const": "github-attestation" },
        "repo": { "$ref": "#/$defs/repo" },
        "workflow": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$" },
        "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^refs/(heads|tags)/.+$" } },
        "issuer": { "type": "string", "format": "uri" }
      }
    },
    "game": {
      "type": "object",
      "required": ["game", "module", "displayName", "home", "tags", "client", "release"],
      "additionalProperties": false,
      "properties": {
        "game": { "$ref": "#/$defs/text" },
        "module": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "displayName": { "$ref": "#/$defs/text" },
        "home": { "type": "string", "format": "uri" },
        "tags": { "$ref": "#/$defs/textList" },
        "client": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "release": {
          "type": "object",
          "required": ["repo", "world", "manifest", "bundle"],
          "additionalProperties": false,
          "properties": {
            "repo": { "$ref": "#/$defs/repo" },
            "world": { "$ref": "#/$defs/text" },
            "manifest": { "$ref": "#/$defs/text" },
            "bundle": { "$ref": "#/$defs/text" }
          }
        }
      }
    }
  }
}
